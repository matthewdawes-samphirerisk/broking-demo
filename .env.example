# Copy this file to .env and fill in the values from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# .env is gitignored and must stay that way. On Railway these are set under
# the service's Variables tab instead - the same code, no secret in the repo.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The SECRET key (starts sb_secret_), from Project Settings -> API Keys ->
# Secret keys. NOT the publishable key, which is the browser-safe one.
#
# Supabase renamed these in 2026: publishable = the old anon key, secret = the
# old service_role key. Older material and the Legacy tab still use the old
# names for the same two things.
#
# This key bypasses row level security, so it only ever lives server-side.
# If it reaches a browser or a commit, rotate it in the dashboard immediately.
SUPABASE_SERVICE_KEY=

# Signs the session cookie. Any long random string. If it is not set the server
# generates one at startup, which works but logs everyone out on every restart -
# fine locally, wrong in production.
SESSION_SECRET=

# Set to false to run the dashboard with no sign-in at all, which is how it is
# shown for most of the demo. Anything else (or unset) means sign-in required.
AUTH_REQUIRED=true

# Set to production on the host. This is what puts the Secure flag on the
# session cookie, so it is only ever sent over HTTPS. Railway does not always
# set it for you - add it explicitly under Variables.
NODE_ENV=production
