# Copy this file to .env and fill in the values from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# .env is gitignored and must stay that way. On Railway these are set under
# the service's Variables tab instead - the same code, no secret in the repo.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The SERVICE ROLE key, not the anon key. It bypasses row level security, so
# it must only ever be used server-side. If this ever reaches a browser or a
# commit, rotate it in the Supabase dashboard immediately.
SUPABASE_SERVICE_KEY=
