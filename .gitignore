# Dependencies
node_modules/

# Secrets — never commit. THIS REPOSITORY IS PUBLIC.
.env
.env.*
!.env.example
*.key
*.pem

# Backstop: anything whose name suggests it carries credentials. This is a
# safety net for an accidental "git add -A", not a filing system — secrets
# should not be in the repo folder at all. A near miss on 26 Aug 2026, when a
# Word document holding the Supabase secret key was saved in here, is why
# these lines exist.
*secret*
*Secret*
*SECRET*
*credential*
*Credential*
*password*
*Password*

# OS junk
.DS_Store
Thumbs.db
desktop.ini
~$*

# Editor / IDE
.vscode/
.idea/

# NOTE: the data files in data/ are deliberately committed.
# They are wholly synthetic and safe to publish.

# public/data.js is no longer used - session two reads from Supabase via /api/policies.
